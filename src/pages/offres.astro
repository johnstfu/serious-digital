---
import Layout from '../layouts/Layout.astro';

const title = 'Nos offres — SeRious | Sites Agentic Friendly & Stratégie Digitale';
const description = 'Création de site, refonte, stratégie digitale ou package complet. Des offres claires, adaptées aux PME, pour être visible sur Google et sur l\'IA.';

const offers = [
  {
    href: '/offres/creation-site',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>`,
    iconColor: 'text-coral',
    iconBg: 'bg-coral/10',
    title: 'Création de site',
    desc: 'Vous n\'avez pas encore de site, ou celui que vous avez ne vous représente plus. On construit votre vitrine en ligne de A à Z — design, contenu, technique.',
    features: ['Design sur mesure, responsive', 'SEO technique intégré', 'Optimisation GEO (IA)', 'Google Business Profile', 'Hébergement 1 an inclus'],
    accentColor: '#FF6B4A',
  },
  {
    href: '/offres/refonte-site',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/></svg>`,
    iconColor: 'text-amber',
    iconBg: 'bg-amber/10',
    title: 'Refonte de site',
    desc: 'Votre site date, il n\'est pas mobile, mal référencé. On le reprend sur des bases solides — sans perdre ce qui fonctionne déjà.',
    features: ['Audit de l\'existant', 'Migration propre', 'Nouveau design performant', 'SEO + GEO reconfigurés', 'Formation utilisation'],
    accentColor: '#F59E0B',
  },
  {
    href: '/offres/strategie-digitale',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6"/></svg>`,
    iconColor: 'text-teal',
    iconBg: 'bg-teal/10',
    title: 'Stratégie digitale',
    desc: 'Vous avez déjà un site correct ? On gère le reste : réseaux, contenu, référencement, visibilité. 6 mois d\'accompagnement.',
    features: ['Audit présence digitale', 'Plan réseaux sociaux', 'Accompagnement contenu', 'Rapports mensuels', 'Tracking visibilité IA'],
    accentColor: '#14B8A6',
  },
  {
    href: '/offres/package-complet',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/></svg>`,
    iconColor: 'text-white',
    iconBg: '',
    title: 'Package complet',
    desc: 'Site + stratégie + accompagnement 6 mois. La formule tout-en-un pour les PME qui veulent des résultats.',
    features: ['Tout "Création de site"', 'Tout "Stratégie digitale"', 'Audit offert (valeur 300€)', 'Maintenance incluse', 'Priorité sur les évolutions'],
    accentColor: '#FF6B4A',
    highlighted: true,
  },
];
---

<Layout title={title} description={description}>

  <!-- Hero -->
  <section class="section bg-cream">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <div class="badge-coral mb-4">Nos offres</div>
        <h1 class="text-hero mb-6">
          Des offres <span class="text-gradient">claires et adaptées</span> à votre besoin
        </h1>
        <p class="text-subtitle text-muted">
          Pas de surprise, pas de jargon. On vous dit exactement ce que vous obtenez, combien ça coûte, et ce que ça va changer.
        </p>
      </div>
    </div>
  </section>

  <!-- Grille offres -->
  <section class="section">
    <div class="container-narrow">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {offers.map((offer) => (
          <a href={offer.href} class={`${offer.highlighted ? 'card-highlight' : 'card'} group cursor-pointer flex flex-col`}>
            <div class="flex items-start gap-4 mb-5">
              <div class={`w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 ${offer.iconBg} ${offer.iconColor}`}
                   style={offer.highlighted ? 'background: linear-gradient(135deg, #FF6B4A 0%, #F59E0B 100%);' : ''}>
                <span set:html={offer.icon} />
              </div>
              <div>
                {offer.highlighted && <span class="badge-amber mb-2">Recommandé</span>}
                <h2 class="font-display font-bold text-xl">{offer.title}</h2>
              </div>
            </div>
            <p class="text-muted leading-relaxed mb-6">{offer.desc}</p>
            <ul class="space-y-2.5 mb-6 flex-1">
              {offer.features.map((f) => (
                <li class="flex items-center gap-2.5 text-sm">
                  <svg class="w-4 h-4 text-teal shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  <span class="text-muted">{f}</span>
                </li>
              ))}
            </ul>
            <div class="flex items-center gap-2 text-coral font-display font-semibold text-sm group-hover:underline">
              Voir le détail
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-cream">
    <div class="container-narrow text-center">
      <h2 class="text-section mb-4">Une question sur nos offres ?</h2>
      <p class="text-subtitle text-muted max-w-xl mx-auto mb-8">
        Prenons 15 minutes pour en discuter. L'audit est gratuit et sans engagement.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn-primary">Demander un audit gratuit</a>
        <a href="/faq" class="btn-secondary">Consulter la FAQ</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "provider": { "@id": "https://serious-digital.fr/#organization" },
    "name": "Package complet — Site Agentic Friendly + Stratégie Digitale",
    "description": "Création de site web optimisé SEO et GEO avec accompagnement stratégie digitale 6 mois pour PME.",
    "areaServed": { "@type": "Country", "name": "France" },
    "offers": { "@type": "Offer", "price": "1500", "priceCurrency": "EUR", "description": "Package complet : site + stratégie digitale + accompagnement 6 mois" }
  })} />
</Layout>
