---
import Layout from '../layouts/Layout.astro';

const title = 'Brief client | SeRious';
const description = 'Remplissez ce brief avant notre rendez-vous — il nous permet de préparer une proposition adaptée à votre projet.';
---

<Layout title={title} description={description}>
  <section class="min-h-screen bg-cream flex flex-col">

    <!-- En-tête -->
    <div class="bg-white border-b border-warm-200 px-4 py-4">
      <div class="max-w-2xl mx-auto flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-coral flex items-center justify-center text-white font-bold text-sm flex-shrink-0">R</div>
        <div>
          <p class="font-semibold text-navy text-sm">Rayane — SeRious</p>
          <p class="text-xs text-muted">Agence digitale · En ligne</p>
        </div>
      </div>
    </div>

    <!-- Zone de chat -->
    <div class="flex-1 flex flex-col max-w-2xl w-full mx-auto px-4 py-6 gap-4">

      <!-- Messages -->
      <div id="messages" class="flex-1 flex flex-col gap-3 overflow-y-auto">
        <!-- Message initial de Rayane -->
        <div class="flex gap-2.5 items-end">
          <div class="w-7 h-7 rounded-full bg-coral flex items-center justify-center text-white text-xs font-bold flex-shrink-0">R</div>
          <div class="bg-white rounded-2xl rounded-bl-sm px-4 py-3 shadow-card max-w-[80%]">
            <p class="text-sm text-navy leading-relaxed">
              Bonjour ! Je suis Rayane, de SeRious 👋<br><br>
              Je vais vous poser quelques questions pour préparer notre échange et vous proposer quelque chose d'adapté à votre projet. Ça prend environ 3-4 minutes.<br><br>
              Pour commencer — quel est votre prénom et nom, et le nom de votre entreprise ?
            </p>
          </div>
        </div>
      </div>

      <!-- Écran de succès (masqué par défaut) -->
      <div id="success-screen" class="hidden flex-1 flex flex-col items-center justify-center text-center py-12 gap-6">
        <div class="w-16 h-16 rounded-full bg-teal/10 flex items-center justify-center">
          <svg class="w-8 h-8 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <div>
          <h2 class="text-xl font-bold text-navy mb-2">Brief bien reçu !</h2>
          <p class="text-muted text-sm max-w-sm leading-relaxed">
            Je reviens vers vous dans les 24 heures avec une proposition adaptée à votre projet.
          </p>
        </div>
        <a href="/" class="btn-secondary text-sm">Retour au site →</a>
      </div>

      <!-- Indicateur de frappe -->
      <div id="typing-indicator" class="hidden flex gap-2.5 items-end">
        <div class="w-7 h-7 rounded-full bg-coral flex items-center justify-center text-white text-xs font-bold flex-shrink-0">R</div>
        <div class="bg-white rounded-2xl rounded-bl-sm px-4 py-3.5 shadow-card">
          <div class="flex gap-1 items-center h-4">
            <span class="w-2 h-2 rounded-full bg-coral/50 animate-bounce" style="animation-delay: 0ms"></span>
            <span class="w-2 h-2 rounded-full bg-coral/50 animate-bounce" style="animation-delay: 150ms"></span>
            <span class="w-2 h-2 rounded-full bg-coral/50 animate-bounce" style="animation-delay: 300ms"></span>
          </div>
        </div>
      </div>

      <!-- Input -->
      <div id="input-area" class="flex gap-2 items-end pt-2">
        <textarea
          id="user-input"
          placeholder="Votre réponse..."
          rows="1"
          class="flex-1 resize-none rounded-2xl border border-warm-200 bg-white px-4 py-3 text-sm text-navy placeholder:text-muted-light focus:outline-none focus:ring-2 focus:ring-coral/30 focus:border-coral transition-all shadow-sm"
          style="max-height: 120px; overflow-y: auto;"
        ></textarea>
        <button
          id="send-btn"
          class="w-10 h-10 rounded-full bg-coral hover:bg-coral-dark transition-colors flex items-center justify-center flex-shrink-0 disabled:opacity-40 disabled:cursor-not-allowed"
          aria-label="Envoyer"
        >
          <svg class="w-4 h-4 text-white rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
        </button>
      </div>

    </div>
  </section>
</Layout>

<script>
  // Historique de la conversation
  const conversationHistory = []

  // DOM
  const messagesEl = document.getElementById('messages')
  const typingEl = document.getElementById('typing-indicator')
  const inputEl = document.getElementById('user-input')
  const sendBtn = document.getElementById('send-btn')
  const successScreen = document.getElementById('success-screen')
  const inputArea = document.getElementById('input-area')

  // Auto-resize du textarea
  inputEl.addEventListener('input', () => {
    inputEl.style.height = 'auto'
    inputEl.style.height = Math.min(inputEl.scrollHeight, 120) + 'px'
  })

  // Envoyer avec Entrée (Shift+Entrée pour nouvelle ligne)
  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault()
      handleSend()
    }
  })

  sendBtn.addEventListener('click', handleSend)

  function addMessage(role, text) {
    const isUser = role === 'user'
    const wrapper = document.createElement('div')
    wrapper.className = isUser
      ? 'flex gap-2.5 items-end justify-end'
      : 'flex gap-2.5 items-end'

    const html = isUser
      ? `<div class="bg-coral rounded-2xl rounded-br-sm px-4 py-3 shadow-sm max-w-[80%]">
           <p class="text-sm text-white leading-relaxed whitespace-pre-wrap">${escapeHtml(text)}</p>
         </div>`
      : `<div class="w-7 h-7 rounded-full bg-coral flex items-center justify-center text-white text-xs font-bold flex-shrink-0">R</div>
         <div class="bg-white rounded-2xl rounded-bl-sm px-4 py-3 shadow-card max-w-[80%]">
           <p class="text-sm text-navy leading-relaxed whitespace-pre-wrap">${escapeHtml(text)}</p>
         </div>`

    wrapper.innerHTML = html
    messagesEl.appendChild(wrapper)
    scrollToBottom()
  }

  function showTyping() {
    typingEl.classList.remove('hidden')
    typingEl.classList.add('flex')
    scrollToBottom()
  }

  function hideTyping() {
    typingEl.classList.add('hidden')
    typingEl.classList.remove('flex')
  }

  function setInputEnabled(enabled) {
    inputEl.disabled = !enabled
    sendBtn.disabled = !enabled
  }

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight
    window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' })
  }

  function escapeHtml(text) {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
  }

  async function handleSend() {
    const text = inputEl.value.trim()
    if (!text || sendBtn.disabled) return

    // Afficher le message utilisateur
    addMessage('user', text)
    conversationHistory.push({ role: 'user', content: text })

    // Reset input
    inputEl.value = ''
    inputEl.style.height = 'auto'
    setInputEnabled(false)
    showTyping()

    try {
      const res = await fetch('/.netlify/functions/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: conversationHistory }),
      })

      if (!res.ok) throw new Error(`HTTP ${res.status}`)

      const data = await res.json()
      hideTyping()

      // Afficher la réponse
      if (data.reply) {
        addMessage('assistant', data.reply)
        conversationHistory.push({ role: 'assistant', content: data.reply })
      }

      // Brief complet → soumettre
      if (data.briefData) {
        setInputEnabled(false)
        inputArea.classList.add('hidden')
        await submitBrief(data.briefData)
      } else {
        setInputEnabled(true)
        inputEl.focus()
      }

    } catch (err) {
      hideTyping()
      console.error('Erreur chat:', err)
      addMessage('assistant', "Désolé, une erreur s'est produite. Réessayez dans un instant.")
      setInputEnabled(true)
    }
  }

  async function submitBrief(briefData) {
    try {
      await fetch('/.netlify/functions/submit-brief', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(briefData),
      })
    } catch (err) {
      console.error('Erreur submit brief:', err)
    }

    // Afficher l'écran de succès dans tous les cas
    setTimeout(() => {
      messagesEl.classList.add('hidden')
      successScreen.classList.remove('hidden')
      successScreen.classList.add('flex')
    }, 1500)
  }
</script>

<style>
  /* Assure que la section fait au moins 100vh */
  section {
    min-height: 100dvh;
  }

  #messages {
    min-height: 300px;
  }

  /* Scrollbar discrète */
  #messages::-webkit-scrollbar {
    width: 4px;
  }
  #messages::-webkit-scrollbar-track {
    background: transparent;
  }
  #messages::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 2px;
  }
</style>
