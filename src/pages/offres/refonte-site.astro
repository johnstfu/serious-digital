---
import Layout from '../../layouts/Layout.astro';

const title = 'Refonte de site web — SeRious | Modernisez votre présence en ligne';
const description = 'Votre site est vieux, pas mobile, mal référencé ? On le reprend sur des bases solides avec SEO + GEO intégrés.';
---

<Layout title={title} description={description}>

  <section class="section bg-cream">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <a href="/offres" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-coral transition-colors mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Retour aux offres
        </a>
        <div class="badge-amber mb-4">Refonte de site</div>
        <h1 class="text-hero mb-6">Votre site existe,<br><span class="text-gradient">mais il ne performe pas</span></h1>
        <p class="text-subtitle text-muted">Un site daté, pas mobile, mal référencé ? On repart sur des bases solides sans perdre ce qui fonctionne déjà. Design neuf, technique propre, SEO + GEO intégrés.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-section mb-6">Ce qui est inclus</h2>
          <ul class="space-y-4 mb-8">
            {[
              { title: 'Audit de l\'existant', desc: 'On analyse ce qui fonctionne, ce qui ne fonctionne pas, et pourquoi.' },
              { title: 'Migration propre', desc: 'Pas de perte de contenu ou de référencement. On migre intelligemment.' },
              { title: 'Nouveau design performant', desc: 'Responsive, rapide, moderne — à votre image.' },
              { title: 'SEO + GEO reconfigurés', desc: 'On reprend tout le référencement de zéro, Google ET IA.' },
              { title: 'Formation utilisation', desc: 'Vous savez gérer les bases de votre site en autonomie.' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <div class="w-6 h-6 rounded-full bg-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5 text-teal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                </div>
                <div>
                  <p class="font-display font-semibold text-navy">{item.title}</p>
                  <p class="text-sm text-muted">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-primary">Demander un audit gratuit</a>
        </div>

        <div class="card-cream p-8">
          <h3 class="font-display font-semibold text-lg mb-5">Signes qu'il est temps de refondre</h3>
          <ul class="space-y-4">
            {[
              'Votre site date de plus de 3 ans',
              'Il n\'est pas adapté au mobile',
              'Il charge lentement',
              'Vous n\'apparaissez pas sur Google',
              'Les IA ne vous citent jamais',
            ].map((item) => (
              <li class="flex items-center gap-3 bg-white p-3 rounded-xl border border-warm-200">
                <div class="w-8 h-8 rounded-lg bg-amber/10 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
                </div>
                <span class="text-sm font-medium text-navy">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
