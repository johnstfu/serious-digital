---
import Layout from '../../layouts/Layout.astro';

const title = 'Stratégie digitale — SeRious | Accompagnement 6 mois pour PME';
const description = 'Accompagnement stratégie digitale 6 mois pour PME : réseaux sociaux, contenu, référencement, rapports mensuels.';
---

<Layout title={title} description={description}>

  <section class="section bg-cream">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <a href="/offres" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-coral transition-colors mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Retour aux offres
        </a>
        <div class="badge-teal mb-4">Stratégie digitale</div>
        <h1 class="text-hero mb-6">Votre site existe,<br><span class="text-gradient">on s'occupe du reste</span></h1>
        <p class="text-subtitle text-muted">Avoir un site ne suffit pas. Il faut le faire vivre. Pendant 6 mois, on gère réseaux, contenu, référencement — avec des résultats mesurables.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-section mb-6">Ce qui est inclus</h2>
          <ul class="space-y-4 mb-8">
            {[
              { title: 'Audit complet de présence', desc: 'On fait le point sur votre visibilité Google + IA.' },
              { title: 'Plan réseaux sociaux', desc: 'Stratégie personnalisée, calendrier éditorial, recommandations.' },
              { title: 'Accompagnement contenu', desc: 'On vous aide à créer du contenu qui travaille pour vous.' },
              { title: 'Google Business Profile', desc: 'Fiche optimisée, stratégie d\'avis clients.' },
              { title: 'Rapports mensuels', desc: 'Rapport de visibilité Google + IA, recommandations.' },
              { title: 'Tracking visibilité IA', desc: 'Scoring de votre visibilité sur ChatGPT, Perplexity, Gemini.' },
            ].map((item) => (
              <li class="flex items-start gap-4">
                <div class="w-6 h-6 rounded-full bg-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5 text-teal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                </div>
                <div>
                  <p class="font-display font-semibold text-navy">{item.title}</p>
                  <p class="text-sm text-muted">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>
          <a href="/contact" class="btn-primary">Demander un audit gratuit</a>
        </div>

        <div class="space-y-6">
          <div class="card-cream p-8">
            <h3 class="font-display font-semibold text-lg mb-5">Ce que vous recevez chaque mois</h3>
            <ul class="space-y-4">
              {[
                { icon: 'chart', text: 'Rapport de visibilité (Google + IA)' },
                { icon: 'pen', text: 'Recommandations de contenu' },
                { icon: 'phone', text: 'Accompagnement réseaux sociaux' },
                { icon: 'bolt', text: 'Ajustements et optimisations' },
              ].map((item) => (
                <li class="flex items-center gap-3 bg-white p-3 rounded-xl border border-warm-200">
                  <div class="w-8 h-8 rounded-lg bg-teal/10 flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                  </div>
                  <span class="text-sm font-medium text-navy">{item.text}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="card p-6 border-coral/20">
            <p class="text-sm text-muted mb-2">Besoin aussi d'un site ?</p>
            <a href="/offres/package-complet" class="text-coral font-semibold text-sm hover:underline">
              Voir le Package complet (site + stratégie) &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
