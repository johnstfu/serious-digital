---
import Layout from '../../layouts/Layout.astro';

const title = 'Package complet — SeRious | Site + Stratégie digitale 6 mois';
const description = 'Le package complet SeRious : création de site Agentic Friendly + stratégie digitale + accompagnement 6 mois. À partir de 1500€.';
---

<Layout title={title} description={description}>

  <section class="relative overflow-hidden py-24 md:py-32 text-white" style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);">
    <div class="blob w-[400px] h-[400px] bg-coral/10 top-[-10%] right-[-10%]"></div>
    <div class="blob w-[300px] h-[300px] bg-amber/5 bottom-[10%] left-[-5%]"></div>
    <div class="container-narrow relative z-10">
      <div class="max-w-2xl">
        <a href="/offres" class="inline-flex items-center gap-1.5 text-sm text-white/50 hover:text-coral transition-colors mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Retour aux offres
        </a>
        <div class="badge-amber mb-4">Recommandé</div>
        <h1 class="text-hero mb-6">Le package complet :<br><span class="text-gradient">site + stratégie + suivi</span></h1>
        <p class="text-subtitle text-white/60">Tout ce qu'il faut pour que votre entreprise soit trouvée — et que ça dure. Un site performant, un accompagnement sur 6 mois, et des résultats mesurables.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <div class="card max-w-4xl mx-auto p-8 md:p-12 relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1.5" style="background: linear-gradient(135deg, #FF6B4A 0%, #F59E0B 100%);"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <div>
            <h3 class="font-display font-semibold text-lg mb-4 flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-coral/10 flex items-center justify-center"><svg class="w-4 h-4 text-coral" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg></div>
              Tout "Création de site"
            </h3>
            <ul class="space-y-2 text-sm text-muted">
              {['Design moderne et responsive', 'Jusqu\'à 5 pages', 'SEO technique complet', 'Optimisation GEO (IA)', 'Google Business Profile', 'Hébergement inclus'].map((i) => (
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-teal shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>{i}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="font-display font-semibold text-lg mb-4 flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-teal/10 flex items-center justify-center"><svg class="w-4 h-4 text-teal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3"/></svg></div>
              Tout "Stratégie digitale"
            </h3>
            <ul class="space-y-2 text-sm text-muted">
              {['Audit complet de présence', 'Stratégie réseaux sociaux', 'Accompagnement contenu', 'Rapports mensuels', 'Tracking visibilité IA', 'Ajustements continus'].map((i) => (
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-teal shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>{i}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="border-t border-warm-200 pt-8 mb-8">
          <h3 class="font-display font-semibold text-lg mb-4">Bonus exclusifs du package</h3>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {[
              'Audit professionnel offert (valeur 300€)',
              'Scoring visibilité IA /100',
              'Maintenance site incluse',
              'Priorité sur les évolutions',
            ].map((item) => (
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-4 h-4 text-coral shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span class="text-muted">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-cream rounded-2xl p-6 text-center">
          <p class="text-muted text-sm mb-2">À partir de</p>
          <div class="flex items-baseline justify-center gap-2 mb-2">
            <span class="text-4xl font-display font-bold text-navy">1 500€</span>
            <span class="text-muted text-sm">/ 6 mois</span>
          </div>
          <p class="text-xs text-muted mb-6">Site + accompagnement + maintenance incluse</p>
          <a href="/contact" class="btn-primary">
            Demander un audit gratuit
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
