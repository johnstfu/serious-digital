---
import Layout from '../../layouts/Layout.astro';

const title = 'Réalisation Artisans — SeRious | D\'un site Wix à une vitrine performante';
const description = 'Étude de cas : comment un artisan coiffeur est passé d\'un vieux site Wix à une vitrine qui remplit son agenda.';
---

<Layout title={title} description={description}>

  <section class="section" style="background: linear-gradient(180deg, #FFF8F5 0%, #FFF1EB 100%);">
    <div class="container-narrow">
      <a href="/realisations" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-coral transition-colors mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Toutes les réalisations
      </a>
      <div class="badge-amber mb-4">Artisans & Services</div>
      <h1 class="text-hero mb-6">D'un site Wix oublié<br><span class="text-gradient">à une vitrine qui remplit l'agenda</span></h1>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 space-y-10">
          <div>
            <h2 class="font-display font-bold text-xl mb-4 flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-rose/10 flex items-center justify-center"><span class="text-rose font-bold text-sm">1</span></div>
              Le problème
            </h2>
            <p class="text-muted leading-relaxed">Un vieux site Wix non responsive, aucun référencement, zéro avis Google. L'artisan travaillait uniquement par le bouche à oreille — pas de visibilité numérique.</p>
          </div>

          <div>
            <h2 class="font-display font-bold text-xl mb-4 flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-amber/10 flex items-center justify-center"><span class="text-amber font-bold text-sm">2</span></div>
              Ce qu'on a fait
            </h2>
            <p class="text-muted leading-relaxed">Refonte complète du site, stratégie avis clients, accompagnement réseaux sociaux pendant 6 mois. Fiche Google optimisée, données structurées pour la recherche locale IA.</p>
          </div>

          <div>
            <h2 class="font-display font-bold text-xl mb-4 flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-teal/10 flex items-center justify-center"><span class="text-teal font-bold text-sm">3</span></div>
              Les résultats
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {[
                { stat: '72/100', label: 'Visibilité IA (de 0)' },
                { stat: 'Top 3', label: 'Google sur "coiffeur + ville"' },
                { stat: '90%', label: 'Agenda rempli' },
              ].map((r) => (
                <div class="card-cream p-5 text-center">
                  <div class="text-2xl font-display font-bold text-gradient mb-1">{r.stat}</div>
                  <p class="text-xs text-muted">{r.label}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="card p-6">
            <h3 class="font-display font-semibold text-lg mb-3">Fiche projet</h3>
            <dl class="space-y-3 text-sm">
              <div><dt class="text-muted">Secteur</dt><dd class="font-medium text-navy">Coiffure & Beauté</dd></div>
              <div><dt class="text-muted">Offre utilisée</dt><dd class="font-medium text-navy">Package complet</dd></div>
              <div><dt class="text-muted">Durée</dt><dd class="font-medium text-navy">6 mois</dd></div>
              <div><dt class="text-muted">Livrables</dt><dd class="font-medium text-navy">Refonte site + réseaux + avis clients</dd></div>
            </dl>
          </div>
          <div class="rounded-3xl p-6 text-center" style="background: linear-gradient(135deg, rgba(245,158,11,0.05), rgba(225,29,72,0.05)); border: 1px solid rgba(245,158,11,0.1);">
            <p class="text-sm text-muted mb-3">Situation similaire ?</p>
            <a href="/contact" class="btn-primary text-sm !py-2.5 w-full">Demander un audit</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
