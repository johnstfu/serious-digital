---
import Layout from '../layouts/Layout.astro';

const title = 'Votre site est-il prêt pour l\'IA ? | SeRious';
const description = 'En 2025, 40% des recherches passent par l\'IA. Votre site est-il optimisé pour ChatGPT, Perplexity et Gemini ? Audit gratuit et accompagnement 6 mois.';
---

<Layout title={title} description={description}>

  <!-- ==========================================
       HERO — Question percutante
       ========================================== -->
  <section class="min-h-[90vh] flex items-center justify-center bg-white">
    <div class="container-narrow text-center py-20">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-coral/5 border border-coral/10 mb-8">
        <span class="w-2 h-2 rounded-full bg-coral animate-pulse"></span>
        <span class="text-sm text-coral font-medium">Le nouveau réflexe de vos clients</span>
      </div>

      <h1 class="text-hero mb-8">
        Votre site est-il<br>
        <span class="text-gradient">prêt pour l'IA ?</span>
      </h1>

      <p class="text-xl text-muted max-w-2xl mx-auto mb-12 leading-relaxed">
        Vos clients vous cherchent sur ChatGPT, Perplexity et Gemini.<br>
        <strong class="text-navy">Est-ce qu'ils vous trouvent ?</strong>
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="#methode" class="btn-primary">
          Voir la méthode
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <a href="/contact" class="btn-secondary">
          Audit gratuit
        </a>
      </div>
    </div>
  </section>

  <!-- ==========================================
       SOCIAL PROOF TICKER
       ========================================== -->
  <section class="py-10 bg-white overflow-hidden relative">
    <!-- fade edges -->
    <div class="absolute inset-y-0 left-0 w-24 z-10 pointer-events-none" style="background: linear-gradient(to right, white, transparent)"></div>
    <div class="absolute inset-y-0 right-0 w-24 z-10 pointer-events-none" style="background: linear-gradient(to left, white, transparent)"></div>

    <div class="flex">
      <div class="flex gap-5 animate-ticker">
        {[
          { quote: "Avec un accompagnement pro et impactant, SeRious a repris en main ma présence en ligne. Mon site m'attire des clients naturellement.", author: "L'Estive", sector: "Restauration" },
          { quote: "SeRious a bien cerné notre problème dès le départ. Leur proposition était pertinente et les ajustements ont été rapides, efficaces, et mesurables très vite.", author: "Beitea", sector: "Commerce" },
          { quote: "Avec un accompagnement pro et impactant, SeRious a repris en main ma présence en ligne. Mon site m'attire des clients naturellement.", author: "L'Estive", sector: "Restauration" },
          { quote: "SeRious a bien cerné notre problème dès le départ. Leur proposition était pertinente et les ajustements ont été rapides, efficaces, et mesurables très vite.", author: "Beitea", sector: "Commerce" },
          { quote: "Avec un accompagnement pro et impactant, SeRious a repris en main ma présence en ligne. Mon site m'attire des clients naturellement.", author: "L'Estive", sector: "Restauration" },
          { quote: "SeRious a bien cerné notre problème dès le départ. Leur proposition était pertinente et les ajustements ont été rapides, efficaces, et mesurables très vite.", author: "Beitea", sector: "Commerce" },
        ].map((item) => (
          <div class="shrink-0 w-80 rounded-2xl px-6 py-5 flex flex-col gap-3" style="background: #0F172A; border: 1px solid rgba(255,255,255,0.07);">
            <div class="flex gap-1">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 text-amber" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-white/75 text-sm leading-relaxed">"{item.quote}"</p>
            <div class="flex items-center gap-2 mt-1">
              <span class="font-semibold text-coral text-sm">{item.author}</span>
              <span class="text-white/25 text-xs">·</span>
              <span class="text-white/40 text-xs">{item.sector}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================
       CONSTATS — Choc des chiffres
       ========================================== -->
  <section class="py-20 bg-cream">
    <div class="container-narrow">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">

        <!-- SI NON -->
        <div class="text-center md:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-rose/10 text-rose text-sm font-semibold mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Si votre réponse est NON
          </div>
          <h2 class="text-3xl md:text-4xl font-display font-bold text-navy mb-6">
            Vous perdez des clients<br>chaque jour
          </h2>
          <div class="space-y-4 text-muted">
            <p class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-rose/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-rose" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
              <span><strong class="text-navy">40% des recherches</strong> passent par l'IA en 2025</span>
            </p>
            <p class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-rose/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-rose" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
              <span>Les entreprises non optimisées perdent <strong class="text-navy">30% de visibilité</strong></span>
            </p>
            <p class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-rose/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-rose" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
              <span>Vos concurrents apparaissent, <strong class="text-navy">pas vous</strong></span>
            </p>
          </div>
        </div>

        <!-- SI OUI -->
        <div class="text-center md:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-teal/10 text-teal text-sm font-semibold mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Si votre réponse est OUI
          </div>
          <h2 class="text-3xl md:text-4xl font-display font-bold text-navy mb-6">
            L'IA devient votre<br>levier de croissance
          </h2>
          <div class="space-y-4 text-muted">
            <p class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-teal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              </span>
              <span><strong class="text-navy">Recommandé automatiquement</strong> par les IA</span>
            </p>
            <p class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-teal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              </span>
              <span>Visibilité sur <strong class="text-navy">Google + tous les assistants IA</strong></span>
            </p>
            <p class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-teal/10 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-teal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              </span>
              <span><strong class="text-navy">Avantage concurrentiel</strong> durable</span>
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==========================================
       MÉTHODE — 3 étapes simples
       ========================================== -->
  <section class="py-24 bg-white" id="methode">
    <div class="container-narrow">
      <div class="text-center mb-16">
        <p class="overline text-coral mb-4">Ma méthode</p>
        <h2 class="text-section mb-4">3 étapes pour rendre votre site<br><span class="text-gradient">visible par l'IA</span></h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- Étape 1 : Audit gratuit -->
        <div class="card-step">
          <div class="step-number">1</div>
          <div class="w-14 h-14 rounded-2xl bg-coral/10 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-coral" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-xl mb-3">Audit gratuit & Recommandations</h3>
          <p class="text-muted leading-relaxed">
            J'analyse votre présence en ligne et je vous explique ce qui fonctionne, ce qui bloque, et ce qu'on peut faire ensemble.
          </p>
          <div class="mt-5 pt-5 border-t border-warm-100">
            <span class="text-sm text-coral font-semibold">Gratuit • Sans engagement</span>
          </div>
        </div>

        <!-- Étape 2 : Réalisation -->
        <div class="card-step card-step-highlight">
          <div class="step-number">2</div>
          <div class="w-14 h-14 rounded-2xl bg-amber/10 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-amber" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-xl mb-3">Création/Refonte & Social Listening</h3>
          <p class="text-muted leading-relaxed">
            Je crée ou refais votre site Agentic Friendly, et/ou je mets en place le Social Listening pour surveiller votre e-réputation.
          </p>
          <div class="mt-5 pt-5 border-t border-warm-100">
            <span class="text-sm text-amber font-semibold">Sur mesure • Selon vos besoins</span>
          </div>
        </div>

        <!-- Étape 3 : Suivi -->
        <div class="card-step">
          <div class="step-number">3</div>
          <div class="w-14 h-14 rounded-2xl bg-teal/10 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-teal" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-xl mb-3">Suivi, Maintenance & Amélioration</h3>
          <p class="text-muted leading-relaxed">
            Je reste à vos côtés : mises à jour, corrections, optimisations continues. Votre présence en ligne reste performante.
          </p>
          <div class="mt-5 pt-5 border-t border-warm-100">
            <span class="text-sm text-teal font-semibold">Inclus • Sur la durée</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==========================================
       OFFRES — Accordion avec 3 formules
       ========================================== -->
  <section class="py-24 bg-cream" id="offres">
    <div class="container-narrow">
      <div class="text-center mb-16">
        <p class="overline text-coral mb-4">Nos formules</p>
        <h2 class="text-section mb-4">Des offres claires,<br><span class="text-gradient">sans surprise</span></h2>
        <p class="text-lg text-muted max-w-2xl mx-auto">Choisissez la formule qui vous convient. Tout est inclus, pas de frais cachés.</p>
      </div>

      <div class="max-w-3xl mx-auto space-y-4">

        <!-- Offre Complète - Mise en avant -->
        <details class="offer-accordion offer-accordion-highlight group" open>
          <summary class="offer-accordion-header list-none">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-coral text-white text-xs font-semibold">
                  ⭐ Recommandé
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-teal/10 text-teal text-xs font-semibold border border-teal/20">
                  1 mois OFFERT
                </span>
              </div>
              <h3 class="font-display font-bold text-xl text-navy">Offre Complète : Création/Refonte de site + Social Listening</h3>
            </div>
            <div class="text-right">
              <div class="text-3xl font-display font-bold text-gradient">1500€</div>
              <div class="text-sm text-muted">une fois</div>
            </div>
            <svg class="w-6 h-6 text-muted shrink-0 transition-transform group-open:rotate-180 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="offer-accordion-content">
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-teal shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Site Agentic Friendly (SEO + GEO)</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-teal shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Maintenance 6 mois incluse</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-teal shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span><strong class="text-navy">Social Listening avec 1 mois OFFERT</strong> ⭐</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-teal shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Reporting + recommandations mensuels</span>
              </li>
            </ul>
            <div class="mt-6 pt-6 border-t border-warm-200">
              <a href="/contact" class="btn-primary">Demander un audit gratuit</a>
            </div>
          </div>
        </details>

        <!-- Création/Refonte de site -->
        <details class="offer-accordion group">
          <summary class="offer-accordion-header list-none">
            <div class="flex-1">
              <h3 class="font-display font-bold text-xl text-navy">Création/Refonte de site</h3>
            </div>
            <div class="text-right">
              <div class="text-3xl font-display font-bold text-navy">1000€</div>
              <div class="text-sm text-muted">une fois</div>
            </div>
            <svg class="w-6 h-6 text-muted shrink-0 transition-transform group-open:rotate-180 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="offer-accordion-content">
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-teal shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Site responsive optimisé Google et IA</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-teal shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Maintenance 6 mois incluse</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-teal shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Données structurées complètes</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-teal shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>Formation à l'autonomie</span>
              </li>
            </ul>
            <div class="mt-6 pt-6 border-t border-warm-200">
              <a href="/contact" class="btn-secondary">En savoir plus</a>
            </div>
          </div>
        </details>

        <!-- Social Listening -->
        <details class="offer-accordion group">
          <summary class="offer-accordion-header list-none">
            <div class="flex-1">
              <h3 class="font-display font-bold text-xl text-navy">Social Listening</h3>
