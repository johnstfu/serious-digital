---
import Layout from '../layouts/Layout.astro';

const title = 'SeRious — Sites Agentic Friendly & Stratégie Digitale pour PME';
const description = 'Votre entreprise visible sur Google ET sur l\'IA. Création de sites web optimisés pour les moteurs de recherche et les intelligences artificielles. Accompagnement stratégie digitale 6 mois.';
---

<Layout title={title} description={description}>

  <!-- ==========================================
       HERO — Warm & Bold
       ========================================== -->
  <section class="relative overflow-hidden min-h-[90vh] flex items-center" style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);">
    <div class="absolute inset-0 overflow-hidden">
      <div class="blob w-[600px] h-[600px] bg-coral/10 top-[-10%] right-[-15%]"></div>
      <div class="blob w-[400px] h-[400px] bg-amber/5 bottom-[10%] left-[-5%]"></div>
      <div class="blob w-[300px] h-[300px] bg-teal/5 top-[60%] right-[20%]"></div>
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>

    <div class="relative container-narrow py-28 md:py-0 text-white">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm mb-8 animate-fade-in">
            <span class="w-2 h-2 rounded-full bg-coral animate-pulse"></span>
            <span class="text-sm text-white/70 font-medium">Le digital qui vous ramène des clients</span>
          </div>

          <h1 class="text-hero mb-8 animate-slide-up">
            Votre entreprise<br>
            visible sur Google<br>
            <span class="text-gradient">ET sur l'IA</span>
          </h1>

          <p class="text-xl text-white/60 max-w-xl mb-10 leading-relaxed animate-slide-up animate-delay-100">
            Vos futurs clients vous cherchent sur Google, mais aussi sur ChatGPT, Perplexity et Gemini.
            On construit le site qui vous rend trouvable partout — et on reste à vos côtés pendant 6 mois.
          </p>

          <div class="flex flex-wrap gap-4 animate-slide-up animate-delay-200">
            <a href="/contact" class="btn-primary">
              Demander un audit gratuit
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
            <a href="/methode" class="btn-outline-light">
              Découvrir notre approche
            </a>
          </div>
        </div>

        <!-- Dashboard visuel -->
        <div class="lg:col-span-5 hidden lg:block animate-slide-left animate-delay-300">
          <div class="relative">
            <div class="card-glass-dark p-6 relative z-10">
              <div class="flex items-center gap-3 mb-5">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #FF6B4A 0%, #F59E0B 100%);">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                </div>
                <div>
                  <p class="text-white font-display font-semibold text-sm">Score de visibilité</p>
                  <p class="text-white/50 text-xs">Exemple de suivi client</p>
                </div>
              </div>
              <div class="space-y-3">
                <div>
                  <div class="flex justify-between text-xs mb-1.5">
                    <span class="text-white/60">Google (SEO)</span>
                    <span class="text-teal font-semibold">92/100</span>
                  </div>
                  <div class="h-2 bg-white/5 rounded-full overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-teal to-teal-light rounded-full" style="width: 92%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-xs mb-1.5">
                    <span class="text-white/60">ChatGPT / Perplexity</span>
                    <span class="text-coral font-semibold">78/100</span>
                  </div>
                  <div class="h-2 bg-white/5 rounded-full overflow-hidden">
                    <div class="h-full rounded-full" style="width: 78%; background: linear-gradient(90deg, #FF6B4A, #F59E0B);"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-xs mb-1.5">
                    <span class="text-white/60">Gemini</span>
                    <span class="text-amber font-semibold">65/100</span>
                  </div>
                  <div class="h-2 bg-white/5 rounded-full overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-amber to-amber-light rounded-full" style="width: 65%"></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="absolute -bottom-6 -left-6 card-glass-dark p-4 z-20 animate-float">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-teal/20 flex items-center justify-center">
                  <svg class="w-4 h-4 text-teal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                </div>
                <div>
                  <p class="text-white text-xs font-semibold">Cité par Perplexity</p>
                  <p class="text-white/40 text-[10px]">il y a 2 heures</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Trust bar -->
      <div class="mt-20 pt-8 border-t border-white/5">
        <div class="flex flex-wrap justify-between items-center gap-8">
          <div class="flex items-center gap-3">
            <div class="flex -space-x-2">
              <div class="w-8 h-8 rounded-full bg-coral/30 border-2 border-navy flex items-center justify-center text-[10px] text-white font-bold">G</div>
              <div class="w-8 h-8 rounded-full bg-teal/30 border-2 border-navy flex items-center justify-center text-[10px] text-white font-bold">P</div>
              <div class="w-8 h-8 rounded-full bg-amber/30 border-2 border-navy flex items-center justify-center text-[10px] text-white font-bold">C</div>
            </div>
            <span class="text-white/40 text-sm">Pensé pour <strong class="text-white/70">Google, ChatGPT, Perplexity, Gemini</strong></span>
          </div>
          <div class="flex flex-wrap gap-6">
            <span class="flex items-center gap-2 text-white/40 text-sm">
              <svg class="w-4 h-4 text-teal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              SEO + GEO intégrés
            </span>
            <span class="flex items-center gap-2 text-white/40 text-sm">
              <svg class="w-4 h-4 text-teal" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              6 mois d'accompagnement
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       STATS — fond crème chaud
       ========================================== -->
  <section class="py-16 md:py-20 bg-cream border-b border-cream-200">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center justify-between gap-10 md:gap-4">
        <div class="counter-block">
          <div class="counter-value text-gradient">60%</div>
          <p class="counter-label">des recherches passent par l'IA en 2026</p>
          <p class="text-[10px] text-muted-light mt-1 uppercase tracking-wider">Gartner</p>
        </div>
        <div class="counter-separator"></div>
        <div class="counter-block">
          <div class="counter-value text-gradient">47,9%</div>
          <p class="counter-label">des citations ChatGPT viennent de sources structurées</p>
          <p class="text-[10px] text-muted-light mt-1 uppercase tracking-wider">Columbia University</p>
        </div>
        <div class="counter-separator"></div>
        <div class="counter-block">
          <div class="counter-value text-gradient">0%</div>
          <p class="counter-label">des PME locales sont optimisées pour l'IA</p>
          <p class="text-[10px] text-muted-light mt-1 uppercase tracking-wider">Estimation marché</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       LE PROBLÈME — fond blanc
       ========================================== -->
  <section class="section">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="overline text-coral mb-4">Ce qui a changé</p>
          <h2 class="text-section mb-6">Le réflexe Google ne suffit plus.</h2>
          <div class="space-y-5 text-muted leading-relaxed text-lg">
            <p>
              Vos clients ne cherchent plus comme avant. Beaucoup posent directement leurs questions à <strong class="text-navy">ChatGPT</strong> ou <strong class="text-navy">Perplexity</strong> :
            </p>
            <p>
              <span class="inline-block mt-1 px-4 py-2 bg-cream rounded-xl border border-cream-200 text-navy font-medium text-base italic">
                "Un bon coiffeur dans le 11ème, tu me conseilles quoi ?"
              </span>
            </p>
            <p>
              Ces IA ne piochent pas au hasard. Elles favorisent les sites avec des données claires, du contenu structuré, et des signaux de confiance.
            </p>
            <p class="font-medium text-navy">C'est exactement ce qu'on met en place pour vous.</p>
          </div>
        </div>

        <div class="space-y-5">
          <div class="rounded-3xl p-6 bg-rose/5 border border-rose/10 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1.5 h-full bg-rose"></div>
            <div class="pl-5">
              <div class="flex items-center gap-2 mb-3">
                <svg class="w-5 h-5 text-rose" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                <h3 class="font-display font-bold text-rose">Un site classique</h3>
              </div>
              <ul class="space-y-2 text-sm text-rose/70">
                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-rose/50"></span>Aucune donnée structurée</li>
                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-rose/50"></span>Les IA ne le voient pas</li>
                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-rose/50"></span>Référencement faible ou inexistant</li>
              </ul>
            </div>
          </div>

          <div class="rounded-3xl p-6 bg-teal/5 border border-teal/10 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1.5 h-full bg-teal"></div>
            <div class="pl-5">
              <div class="flex items-center gap-2 mb-3">
                <svg class="w-5 h-5 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <h3 class="font-display font-bold text-navy">Un site Agentic Friendly</h3>
              </div>
              <ul class="space-y-2 text-sm text-muted">
                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-teal"></span>Données structurées complètes (JSON-LD)</li>
                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-teal"></span>Recommandé par ChatGPT, Perplexity, Gemini</li>
                <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-teal"></span>SEO + GEO travaillés ensemble</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       NOS OFFRES — fond sable chaud
       ========================================== -->
  <section class="section-cream" id="offres">
    <div class="container-narrow">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="overline text-coral mb-4">Nos offres</p>
        <h2 class="text-section mb-4">Ce qu'on propose, concrètement</h2>
        <p class="text-lg text-muted">Chaque formule a sa page dédiée. Prenez le temps de regarder ce qui vous correspond.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/offres/creation-site" class="card-cream group cursor-pointer hover:-translate-y-2 transition-all duration-500">
          <div class="w-12 h-12 rounded-2xl bg-coral/10 flex items-center justify-center mb-5 group-hover:bg-coral/20 transition-colors">
            <svg class="w-6 h-6 text-coral" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>
          </div>
          <h3 class="font-display font-bold text-lg mb-2">Création de site</h3>
          <p class="text-muted text-sm leading-relaxed mb-4">Votre vitrine en ligne, pensée pour performer dès le jour 1.</p>
          <span class="text-coral text-sm font-semibold group-hover:underline">Voir le détail &rarr;</span>
        </a>

        <a href="/offres/refonte-site" class="card-cream group cursor-pointer hover:-translate-y-2 transition-all duration-500">
          <div class="w-12 h-12 rounded-2xl bg-amber/10 flex items-center justify-center mb-5 group-hover:bg-amber/20 transition-colors">
            <svg class="w-6 h-6 text-amber" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/></svg>
          </div>
          <h3 class="font-display font-bold text-lg mb-2">Refonte de site</h3>
          <p class="text-muted text-sm leading-relaxed mb-4">Votre site existe mais il ne performe pas ? On repart sur des bases solides.</p>
          <span class="text-amber-dark text-sm font-semibold group-hover:underline">Voir le détail &rarr;</span>
        </a>

        <a href="/offres/strategie-digitale" class="card-cream group cursor-pointer hover:-translate-y-2 transition-all duration-500">
          <div class="w-12 h-12 rounded-2xl bg-teal/10 flex items-center justify-center mb-5 group-hover:bg-teal/20 transition-colors">
            <svg class="w-6 h-6 text-teal" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6"/></svg>
          </div>
          <h3 class="font-display font-bold text-lg mb-2">Stratégie digitale</h3>
          <p class="text-muted text-sm leading-relaxed mb-4">Réseaux, contenu, référencement. On s'occupe de tout le reste.</p>
          <span class="text-teal text-sm font-semibold group-hover:underline">Voir le détail &rarr;</span>
        </a>

        <a href="/offres/package-complet" class="card-highlight group cursor-pointer hover:-translate-y-2 transition-all duration-500">
          <div class="badge-amber mb-4">Recommandé</div>
          <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-5" style="background: linear-gradient(135deg, #FF6B4A 0%, #F59E0B 100%);">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/></svg>
          </div>
          <h3 class="font-display font-bold text-lg mb-2">Package complet</h3>
          <p class="text-muted text-sm leading-relaxed mb-4">Site + stratégie + accompagnement 6 mois. La formule complète.</p>
          <span class="text-coral text-sm font-semibold group-hover:underline">Voir le détail &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==========================================
       RÉALISATIONS — fond blanc
       ========================================== -->
  <section class="section" id="realisations">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
        <div>
          <p class="overline text-coral mb-4">Nos réalisations</p>
          <h2 class="text-section">Des cas concrets,<br><span class="text-muted">secteur par secteur</span></h2>
        </div>
        <a href="/realisations" class="btn-secondary shrink-0">
          Voir toutes les réalisations
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/realisations/restauration" class="case-card group">
          <div class="h-2" style="background: linear-gradient(90deg, #FF6B4A, #F59E0B);"></div>
          <div class="case-card-body">
            <span class="case-card-tag">Restauration</span>
            <h3 class="font-display font-bold text-lg mt-4 mb-3 group-hover:text-coral transition-colors">Un snack invisible qui devient recommandé par les IA</h3>
            <p class="text-sm text-muted leading-relaxed mb-4">Aucune présence en ligne, zéro fiche Google. On a construit sa visibilité de zéro.</p>
            <div class="flex items-center gap-2 text-coral text-sm font-semibold">
              Voir l'étude de cas <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </div>
        </a>

        <a href="/realisations/commerce" class="case-card group">
          <div class="h-2" style="background: linear-gradient(90deg, #14B8A6, #2563EB);"></div>
          <div class="case-card-body">
            <span class="case-card-tag">Commerce</span>
            <h3 class="font-display font-bold text-lg mt-4 mb-3 group-hover:text-coral transition-colors">Doubler sa visibilité en croisant SEO et IA</h3>
            <p class="text-sm text-muted leading-relaxed mb-4">Un site existant mais mal référencé, aucune donnée structurée.</p>
            <div class="flex items-center gap-2 text-coral text-sm font-semibold">
              Voir l'étude de cas <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </div>
        </a>

        <a href="/realisations/artisans" class="case-card group">
          <div class="h-2" style="background: linear-gradient(90deg, #F59E0B, #E11D48);"></div>
          <div class="case-card-body">
            <span class="case-card-tag">Artisans</span>
            <h3 class="font-display font-bold text-lg mt-4 mb-3 group-hover:text-coral transition-colors">D'un site Wix oublié à une vitrine qui remplit l'agenda</h3>
            <p class="text-sm text-muted leading-relaxed mb-4">Refonte complète, stratégie avis clients, accompagnement réseaux sociaux.</p>
            <div class="flex items-center gap-2 text-coral text-sm font-semibold">
              Voir l'étude de cas <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ==========================================
       PROCESS — 4 étapes, fond sombre
       ========================================== -->
  <section class="section-dark relative">
    <div class="container-narrow relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="overline text-coral mb-4">Comment ça se passe</p>
        <h2 class="text-section mb-4">4 étapes, zéro surprise</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { n: '01', title: 'Premier échange', desc: 'On prend 15 min pour comprendre votre activité. Pas de questionnaire, une vraie conversation.', color: '#FF6B4A' },
          { n: '02', title: 'Construction du site', desc: 'Design sur mesure, SEO + GEO dès le départ. Vous validez chaque étape.', color: '#F59E0B' },
          { n: '03', title: 'Mise en ligne', desc: 'Site publié, fiche Google configurée, outils de suivi en place.', color: '#14B8A6' },
          { n: '04', title: 'On reste avec vous', desc: 'Pendant 6 mois : ajustements, réseaux, contenu, optimisations.', color: '#2563EB' },
        ].map((step) => (
          <div class="card-glass-dark relative overflow-hidden hover:-translate-y-1 transition-all duration-500">
            <div class="absolute top-0 left-0 w-1.5 h-full" style={`background-color: ${step.color}`}></div>
            <div class="pl-4 flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl flex items-center justify-center shrink-0" style={`background-color: ${step.color}20`}>
                <span class="font-display font-bold text-lg" style={`color: ${step.color}`}>{step.n}</span>
              </div>
              <div>
                <h3 class="font-display font-bold text-lg mb-2">{step.title}</h3>
                <p class="text-white/50 text-sm leading-relaxed">{step.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

